# ─────────────────────────────────────────────
#  .env.example
#
#  This file is a TEMPLATE. It shows every
#  environment variable the project needs.
#
#  HOW TO USE:
#  1. Copy this file and rename the copy to .env
#  2. Fill in your real values in .env
#  3. Never commit .env to GitHub
# ─────────────────────────────────────────────


# ── NEWS API ──────────────────────────────────
# Get a free key at https://newsapi.org
# Takes 2 minutes to register.
NEWS_API_KEY=your_newsapi_key_here

# Base URL for NewsAPI (do not change unless API changes)
NEWS_API_BASE_URL=https://newsapi.org/v2


# ── MONGODB ───────────────────────────────────
# Local MongoDB (default when MongoDB is installed on your machine)
MONGO_URI=mongodb://localhost:27017

# Name of the database we will create
MONGO_DB_NAME=tech_news


# ── SCHEDULER ─────────────────────────────────
# What time should the daily news fetch run?
# Default: 6:00 AM every day
NEWS_SCHEDULE_HOUR=6
NEWS_SCHEDULE_MINUTE=0


# ── FLASK SERVER ──────────────────────────────
# Port the REST API will run on
FLASK_PORT=5000

# Set to "development" while learning, "production" when deploying
FLASK_ENV=development


# ── APP SETTINGS ──────────────────────────────
# How many news articles to fetch per API call (max 100 for free tier)
NEWS_FETCH_PAGE_SIZE=50

# How many top articles to include in the daily briefing
BRIEFING_TOP_ARTICLES=15
